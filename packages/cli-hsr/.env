# S3 兼容对象存储配置（可公开提交，不放置真实凭据）。
# 加载优先级：进程环境变量 > 可选的 .env.local > 本文件。
# 可在 .env.local 中填写本机覆盖项；不要求复制全部变量。
# 空值是待填写的占位项；未配置完整时，跳过可选的 bucket 图标查询。

# 通用 AWS 兼容访问凭据。临时凭据还可配置 AWS_SESSION_TOKEN。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 根据存储服务要求填写区域。
AWS_REGION=us-east-1

# 通用 endpoint，例如 https://s3.example.com。
AWS_ENDPOINT_URL=
# 可选的 S3 专用 endpoint，非空时优先于 AWS_ENDPOINT_URL。
AWS_ENDPOINT_URL_S3=
# bucket 名称，不含 s3:// 或路径。
S3_BUCKET=
# bucket 内的对象路径前缀，不含首尾斜杠，必须非空。
# 上传写入此目录；编年史图标从其 spriteoutput/chronicle/ 子目录查询。
S3_PREFIX=
# rclone 的标准 provider 配置变量，默认使用通用兼容模式。
RCLONE_S3_PROVIDER=Other
